{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]{2,5}$).*)",
      "destination": "/index.html"
    }
  ]
}
