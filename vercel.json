{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wavenexusdigital.vercel.app" }],
      "destination": "https://wavenexusdigitalinvest.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wavenexusdigital-verov36s-projects.vercel.app" }],
      "destination": "https://wavenexusdigitalinvest.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]{2,5}$).*)",
      "destination": "/index.html"
    }
  ]
}
